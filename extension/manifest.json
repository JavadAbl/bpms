{
  "manifest_version": 3,
  "name": "OA Process Activation",
  "version": "1.9.2",
  "description": "Adds 'فعال سازی فرآیند' to the OA workspace header plus 'جریان کار', 'جریان کار جدید' (draft-first start), 'پیش‌نویس فرآیند', and 'سوابق کارتابل' sidebar items — only while logged in.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage"],
  "host_permissions": ["http://localhost/*", "http://127.0.0.1/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://oa.atie-sazan.ir/*", "https://oa.dayins.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["src/*"],
      "matches": ["https://oa.atie-sazan.ir/*", "https://oa.dayins.com/*"]
    }
  ]
}
